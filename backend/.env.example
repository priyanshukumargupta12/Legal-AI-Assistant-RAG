# =============================================================================
# Enterprise AI Legal Assistant — Environment Variables Template
# =============================================================================
# FILE: backend/.env.example
#
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in every value marked with <YOUR_...>
#   3. NEVER commit the .env file to version control
#   4. Restart the backend after any changes to .env
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# Runtime environment: development | staging | production
APP_ENV=development

# Name shown in API docs, Swagger UI, and logs
APP_NAME=Enterprise AI Legal Assistant

# Semantic version of the API
APP_VERSION=1.0.0

# Uvicorn bind host (0.0.0.0 = accept connections from any interface)
APP_HOST=0.0.0.0

# Uvicorn port — backend will be available at http://localhost:8000
APP_PORT=8000

# Enable hot-reload on code changes (set false in production)
APP_DEBUG=true


# -----------------------------------------------------------------------------
# LLM API KEYS  ← Fill these in
# -----------------------------------------------------------------------------

# Active LLM provider: gemini | openai | groq
LLM_PROVIDER=gemini

# Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Gemini model to use
# Options: gemini-1.5-flash  (fast, free tier)
#          gemini-1.5-pro    (more capable, paid)
#          gemini-2.0-flash  (latest)
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API Key (optional — only needed if LLM_PROVIDER=openai)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# OpenAI model (used only when LLM_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-mini

# Groq API Key (optional — only needed if LLM_PROVIDER=groq)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=<YOUR_GROQ_API_KEY>

# Groq model (used only when LLM_PROVIDER=groq)
GROQ_MODEL=llama-3.3-70b-versatile


# -----------------------------------------------------------------------------
# QDRANT VECTOR DATABASE
# -----------------------------------------------------------------------------

# Connection mode: memory | local | cloud
#   memory → no install needed, data lost on restart (quick testing only)
#   local  → connects to Qdrant running at QDRANT_URL (recommended for dev)
#   cloud  → connects to Qdrant Cloud with API key
QDRANT_MODE=cloud
QDRANT_URL=<YOUR_QDRANT_CLOUD_URL>
QDRANT_API_KEY=<YOUR_QDRANT_CLOUD_API_KEY>
QDRANT_COLLECTION_NAME=legal_documents


# -----------------------------------------------------------------------------
# ELASTICSEARCH
# -----------------------------------------------------------------------------

# Connection URL
ELASTERSEARCH_URL=<YOUR_ELASTICSEARCH_URL>

# API key for Elasticsearch connection (recommended for cloud)
ELASTICSEARCH_API_KEY=<YOUR_ELASTICSEARCH_API_KEY>

# Index name for BM25 keyword search
ELASTICSEARCH_INDEX_NAME=legal_documents


# -----------------------------------------------------------------------------
# EMBEDDING MODEL
# -----------------------------------------------------------------------------

# HuggingFace model used to generate dense text embeddings (e.g. BAAI/bge-small-en-v1.5)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Number of chunks embedded per batch
EMBEDDING_BATCH_SIZE=32

# Local directory where downloaded model weights are cached
EMBEDDING_CACHE_DIR=../embeddings/cache


# -----------------------------------------------------------------------------
# RETRIEVAL SETTINGS
# -----------------------------------------------------------------------------

# Number of results fetched from each retriever (Qdrant + Elasticsearch)
RETRIEVAL_TOP_K=25

# Final number of results returned after RRF merging
RETRIEVAL_FINAL_TOP_K=5

# RRF k constant — controls score smoothing (standard default = 60)
RRF_K=60

# Minimum cosine similarity score for Qdrant results (0.0 = all, 1.0 = exact)
VECTOR_SCORE_THRESHOLD=0.3

# Enable two-stage reranking (CrossEncoder)
USE_RERANKER=false
RERANK_MODEL_NAME=BAAI/bge-reranker-base

# Retrieval confidence thresholds
MIN_VECTOR_SCORE=0.35
MIN_RERANK_SCORE=0.0
MIN_HYBRID_SCORE=0.005


# -----------------------------------------------------------------------------
# CHUNKING SETTINGS
# -----------------------------------------------------------------------------

# Target chunk size in characters
CHUNK_SIZE=750

# Overlap between consecutive chunks in characters
CHUNK_OVERLAP=150


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Log Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log formatting: console | json
LOG_FORMAT=console

# Log file paths relative to backend root
LOG_FILE_PATH=../logs/app/backend.log


# -----------------------------------------------------------------------------
# DIRECTORIES & REGISTRIES
# -----------------------------------------------------------------------------

# Root path for raw datasets containing PDF categories
DATASET_PATH=../dataset

# Target metadata directory for parsed csv, xlsx, json files
METADATA_PATH=../metadata

# Registry file name inside metadata/ tracking all scanned PDFs
DATASET_REGISTRY_FILENAME=documents.csv
